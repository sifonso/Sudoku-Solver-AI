{
  "name": "schichtplaner",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/barlow-semi-condensed": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.73.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "sh -c 'ulimit -s 65532 2>/dev/null; node --stack-size=60000 --max-old-space-size=7000 node_modules/typescript/bin/tsc --noEmit'",
    "tokens": "python3 ../replica/design/build_tokens.py",
    "export:web": "expo export -p web",
    "test:domain": "node --experimental-strip-types --no-warnings --test src/domain/domain.test.ts src/dienstplan/model.test.ts",
    "test:e2e": "playwright test --project=phone --project=desktop",
    "test:live": "NODE_USE_ENV_PROXY=1 playwright test --project=live",
    "test:load": "NODE_USE_ENV_PROXY=1 node scripts/load-test.cjs"
  },
  "private": true
}
